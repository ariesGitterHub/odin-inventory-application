<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('./partials/head.ejs') %>
  </head>
  <body>
    <%- include('./partials/header.ejs') %>
      <div class="card update-item-colors1">
        <h1 class="page-title white capitalize">update existing item</h1>
          <!-- <form method="POST" action="/products/update?_method=PUT/<%#= product.id %>">
            <input type="hidden" name="_method" value="PUT"> -->
          <form class="update-item-form" method="POST" action="/products/<%= product.id %>/update">
          <div>
            <div class="col-container">
              <!-- <div class="col-row-adjustable"> -->
                <div class="update-item-grid1">
                  <label for="product_name">onesie name</label>
                  <input
                    class="lowercase"
                    type="text"
                    id="product_name"
                    name="product_name"
                    value="<%= product.product_name %>"
                    required
                  />
                  <label for="brand">brand</label>
                  <input
                    class="lowercase"
                    type="text"
                    id="brand"
                    name="brand"
                    value="<%= product.brand %>"
                    required
                  />
                  <label for="item_type">item type</label>
                  <input
                    class="lowercase"
                    type="text"
                    id="item_type"
                    name="item_type"
                    value="<%= product.item_type %>"
                  />
                  <label for="price_unit">($) price/unit</label>
                  <input
                    type="number"
                    step="0.01"
                    id="price_unit"
                    name="price_unit"
                    value="<%= product.price_unit %>"
                    required
                  />
                  <label for="cost_unit">($) cost/unit</label>
                  <input
                    type="number"
                    step="0.01"
                    id="cost_unit"
                    name="cost_unit"
                    value="<%= product.cost_unit %>"
                    required
                  />
                  <label for="base_sku">base sku</label>
                  <input
                    class="uppercase"
                    type="text"
                    id="base_sku"
                    name="base_sku"
                    value="<%= product.base_sku %>"
                    required
                  />
                  <label for="rating" hidden>rating</label>
                  <input type="number" id="rating" name="rating" value="0" hidden />
                  <label for="review_count" hidden>reviews</label>
                  <input
                    type="number"
                    id="review_count"
                    name="review_count"
                    value="0"
                    hidden
                  />
                  <label for="front">front image</label>
                  <input
                    type="text"
                    id="front"
                    name="front"
                    value="<%= product.imagesByType?.front?.[0] || '' %>"
                  />
                  <label for="rear">rear image</label>
                  <input
                    type="text"
                    id="rear"
                    name="rear"
                    value="<%= product.imagesByType?.rear?.[0] || '' %>"
                  />
                  <label for="size">sizing image</label>
                  <input
                    type="text"
                    id="size"
                    name="size"
                    value="<%= product.imagesByType?.size?.[0] || '' %>"
                  />
                </div>
              <!-- </div> -->
                <div class="product-tags">
                  <!-- <div class="product-tags"> -->
                    <h2 class="uppercase">tags (comma separated)</h2>
                    <input
                      type="text"
                      id="tags"
                      name="tags"
                      value="<%= product.tags.join(', ') %>"
                    />
                    
                  </div>
                  <div class="col-container">
                    <% const sizes = ['S','M','L','XL']; sizes.forEach(size => {
                    const inv = product.inventoryBySize?.[size]?.[0]; %>
                    <button type="button" class="show-inventory-type-button toggle-inventory">size (<%= size %>) inventory data</button>
                    <div class="update-item-grid2 update-item-colors2 hidden-inventory hidden">
                      <label for="sizes[]">size variant</label>
                      <input class="size" type="text" name="sizes[]" value="<%= size %>" />
                      <label for="barcodes[]">barcode</label>
                      <input class="barcode" type="text" name="barcodes[]" value="<%= inv?.barcode || 'n/a' %>" />    
                      <label for="storage[]">storage</label>
                      <input class="storage" type="text" name="storage[]" value="<%= inv?.storage || 'n/a' %>" />    
                      <label for="units[]">units</label>
                      <input class="units" type="number" name="units[]" value="<%= inv?.units ?? 0 %>" /> 
                    </div>
                   <% }) %>
                    <script src="/js/main.js"></script>
                  </div>
                  <div class="button-container3">
                    <a class="cancel-button" href="/products">Cancel</a>  
                    <button class="submit-button" type="submit" onclick="return confirm('WARNING: changing the base sku may cause inventory issues. Are you sure you want to update this product?')">Update</button>  
                  </div> 
                </div>

              </div>

            </div>

          </div>
        </form>
      </div>
    <%#- include('./partials/footer.ejs') %>
  </body> 
</html>
