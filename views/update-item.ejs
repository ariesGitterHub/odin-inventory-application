<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('./partials/head.ejs') %>
  </head>
  <body>
    <%- include('./partials/header.ejs') %>
    <main>
      <div class="update-item-view">
        <h1 class="create-item-title">Update Item</h1>

        <form method="POST" action="/products/<%= product.id %>?_method=PUT">
          <div class="update-item">
            <div class="update-item-details-col">
              <h1>
                <span class="file-tab-span">
                  <span class="file-tab-text">update this product</span>
                </span>
              </h1>
              <div class="update-item-details-adjustable">
                <div class="update-item-grid overflow-wide">
                  <label for="animal_type">animal</label>
                  <input
                    class="lowercase"
                    type="text"
                    id="animal_type"
                    name="animal_type"
                    value="<%= product.animal_type %>"
                    required
                  />
                  <label for="brand">brand</label>
                  <input
                    class="lowercase"
                    type="text"
                    id="brand"
                    name="brand"
                    value="<%= product.brand %>"
                    required
                  />
                  <label for="item_type">item type</label>
                  <input
                    class="lowercase"
                    type="text"
                    id="item_type"
                    name="item_type"
                    value="<%= product.item_type %>"
                  />
                  <label for="price_unit">($) price/unit</label>
                  <input
                    type="number"
                    step="0.01"
                    id="price_unit"
                    name="price_unit"
                    value="<%= product.price_unit %>"
                    required
                  />
                  <label for="cost_unit">($) cost/unit</label>
                  <input
                    type="number"
                    step="0.01"
                    id="cost_unit"
                    name="cost_unit"
                    value="<%= product.cost_unit %>"
                    required
                  />
                  <label for="base_sku">base sku</label>
                  <input
                    class="uppercase"
                    type="text"
                    id="base_sku"
                    name="base_sku"
                    value="<%= product.base_sku %>"
                    required
                  />
                  <label for="front">front image</label>
                  <input
                    type="text"
                    id="front"
                    name="front"
                    value="<%= product.imagesByType?.front?.[0] || '' %>"
                  />
                  <label for="rear">rear image</label>
                  <input
                    type="text"
                    id="rear"
                    name="rear"
                    value="<%= product.imagesByType?.rear?.[0] || '' %>"
                  />
                  <label for="size">sizing image</label>
                  <input
                    type="text"
                    id="size"
                    name="size"
                    value="<%= product.imagesByType?.size?.[0] || '' %>"
                  />
                </div>
              </div>
              <div class="update-item-details-col">
                <div class="update-item-tags">
                  <h2>search tags</h2>
                  <input
                    type="text"
                    id="tags"
                    name="tags"
                    value="<%= product.tags.join(', ') %>"
                  />
                </div>

                <% const sizes = ['S','M','L','XL']; sizes.forEach(size => {
                const inv = product.inventoryBySize?.[size]?.[0]; %>

                <div class="quick-view-details-row variant-details">
                  <div class="quick-view-category variant-category">
                    <p>variant</p>
                    <p>barcode</p>
                    <p>storage</p>
                    <p>units</p>
                  </div>
                  <div class="quick-view-data variant-data variant-reorder">
                    <input
                      class="size"
                      type="text"
                      name="sizes[]"
                      value="<%= size %>"
                    />
                    <input
                      class="barcode"
                      type="text"
                      name="barcodes[]"
                      value="<%= inv?.barcode || 'n/a (add)' %>"
                    />
                    <input
                      class="storage"
                      type="text"
                      name="storage[]"
                      value="<%= inv?.storage || 'n/a (add)' %>"
                    />
                    <input
                      class="units"
                      type="number"
                      name="units[]"
                      value="<%= inv?.units ?? 0 %>"
                    />
                  </div>
                </div>
                <% }) %>
              </div>
            </div>
          </div>
        </form>
      </div>
    </main>

    <%#- include('./partials/footer.ejs') %>
  </body>
</html>
