<% if (products && products.length) { %> 
  <% products.forEach(product => { %>
    <div class="quick-view">
      <div class="quick-view-details-col main-data">
        <h1>
          <span class="file-tab">quick view: <span class="highlight-color"><%= product.animal_type %></span></span
          >
        </h1>
          <div class="quick-view-details-row">
            <div class="quick-view-image-container">
              <% product.imagesByType.front && product.imagesByType.front.forEach(fn => { %>
              <img
                class="quick-view-image"
                src="/images/<%= fn %>"
                alt="<%= product.animal_type %> front view"
              />
              <% }) %> <% product.imagesByType.rear &&
              product.imagesByType.rear.forEach(fn => { %>
              <img
                class="quick-view-image"
                src="/images/<%= fn %>"
                alt="<%= product.animal_type %> rear view"
              />
              <% }) %>
            </div>

            <div class="quick-view-category">
              <p>brand</p>
              <p>item type</p>        
              <div class="quick-view-money1">
                <p>($) price/unit</p>
                <p>($) cost/unit</p>
                <p class="quick-view-profit1">($) profit/unit</p>
              </div>
              <p>variants</p>
              <p>base sku</p>
              <p>rating</p>
              <p>reviews</p>
              <p>image front</p>
              <p>image back</p>
              <p>sizing image</p>
            </div>
            <div class="quick-view-data">
              <p class="uppercase"><%= product.brand %></p>
              <p><%= product.item_type %></p>
              <div class="quick-view-money2">
                <p><%= product.price_unit %></p>
                <p>-<%= product.cost_unit %></p>
                <p class="quick-view-profit2">
                  <span class="highlight-color2"><%= product.profit_per_unit %></span>
                </p>
              </div>

              <% 
              // Define the custom order of sizes
              const customSizeOrder = ['S', 'M', 'L', 'XL'];

              // Get the size codes from the inventory
              const sizeCodes = Object.keys(product.inventoryBySize);

              // Sort the size codes according to the custom order
              sizeCodes.sort((a, b) => customSizeOrder.indexOf(a) - customSizeOrder.indexOf(b));
              %>

              <%# 

              // Get the size codes from the inventory
              const sizeCodes = Object.keys(product.inventoryBySize);

              %>

              <p><%= sizeCodes.join(", ") %></p>
              <p><%= product.base_sku %></p>
              <p><%= product.rating %></p>
              <p><%= product.review_count %></p>
              <p><%= product.imagesByType.front %></p>
              <p><%= product.imagesByType.rear %></p>
              <p><%= product.imagesByType.size %></p>
            </div>
          </div>
          <div class="quick-view-button-container">
            <button class="card-button toggle-btn color-button">toggle file</button>
            <button class="card-button">update file</button>
          </div>
          <div class="quick-view-notifications">
            <h2>notifications</h2> 
            <% if (product.inventoryBySize && Object.keys(product.inventoryBySize).length > 0) { %>
            <% const customSizeOrder = ['S', 'M', 'L', 'XL']; %>
            <% const sizeCodes = Object.keys(product.inventoryBySize).sort((a, b) => customSizeOrder.indexOf(a) - customSizeOrder.indexOf(b)); %>
            <% sizeCodes.forEach(function(sizeCode) { %>
              <% const size = product.inventoryBySize[sizeCode]; %>
            <div class="notifications">
              <p class="uppercase"><span class="messages"></span> size (<%= sizeCode %>) variant at <% size.forEach(function(variantSize) { %>
              <span class="messageUnitCount"><%= variantSize.units %></span> units.</p>
                    <% }); %>
                </div>
            <% }); %>
          <% } else { %>
            <p>No messages.</p>
          <% } %>
          </div>         
          <div class="quick-view-details-col additional-data hidden">
            <div class="quick-view-tags">
              <h2>search tags</h2>
              <p><%= product.tags.join(", ") %> %></p>
            </div>
            <div class="quick-view-button-container2">
              <button class="card-button long-button">Add/View Notes</button>
              <button class="card-button long-button">Rating History</button>
              <button class="card-button long-button">Pricing History</button>
            </div>
            <div class="quick-view-button-container2">
              <button class="card-button long-button">Sales History</button>
              <button class="card-button long-button">Storage History</button>
              <button class="card-button long-button">Order History</button>
            </div>
            <%#// HOLDER CODE %>
          <% if (product.inventoryBySize && Object.keys(product.inventoryBySize).length > 0) { %>
            <% const customSizeOrder = ['S', 'M', 'L', 'XL']; %>
            <% const sizeCodes = Object.keys(product.inventoryBySize).sort((a, b) => customSizeOrder.indexOf(a) - customSizeOrder.indexOf(b)); %>
            <% sizeCodes.forEach(function(sizeCode) { %>
              <% const size = product.inventoryBySize[sizeCode]; %>
                <div class="quick-view-details-row variant-details">
                  <div class="quick-view-category variant-category">
                    <p>variant</p>
                    <p>sku</p>
                    <p>barcode</p>
                    <p>storage</p>      
                    <p>units</p>
                  </div>
                  <div class="quick-view-data variant-data">
                    <p class="uppercase"> size (<%= sizeCode %>)</p>
                    <% size.forEach(function(variantSize) { %>
                      <p><%= variantSize.sku %></p>
                      <p><%= variantSize.barcode %></p>
                      <p><%= variantSize.storage %></p>      
                      <p class="sizeUnitCount">
                        <%= variantSize.units %>
                        <span class="quick-view-unit-message"></span>
                      </p>
                    <% }); %>
                  </div>
                </div>
            <% }); %>
          <% } else { %>
            <p>No inventory for size <%= sizeCode %>.</p>
          <% } %>
        </div>
      </div>
    </div>
  <% }) %>
  <script src="/js/main.js"></script>
<% } else { %>
  <p class="uppercase">No products found.</p>
<% } %>
