<% if (products && products.length) { %> 
  <% products.sort((a, b) => a.product_name.localeCompare(b.product_name)).forEach(product => { %>
    <div class="card quick-view-colors">
      <div class="main-data">
          <h1>
            <span class="file-tab-span">
              <span class="file-tab-text">quick view:</span> 
              <span class="highlight-color1"><%= product.product_name %></span>
            </span>
          </h1>
          <div class="col-row-adjustable">
            <div class="product-image-container">
              <% product.imagesByType.front && product.imagesByType.front.forEach(filename_or_link => { %>
              <img
                class="product-image"
                src="<%= filename_or_link.startsWith('http') ? filename_or_link : '/images/products/' + filename_or_link %>"
                alt="<%= product.product_name %> front view"
              />
              <% }) %> 
              <% product.imagesByType.rear &&
              product.imagesByType.rear.forEach(filename_or_link => { %>
              <img
                class="product-image"
                src="<%= filename_or_link.startsWith('http') ? filename_or_link : '/images/products/' + filename_or_link %>"
                alt="<%= product.product_name %> rear view"
              />
              <% }) %>
            </div>
            <div class="row-container">            
              <div class="product-category">
                <p>brand</p>
                <p>item type</p>        
                <div>
                  <p>($) price/unit</p>
                  <p>($) cost/unit</p>
                  <p class="profit-line1">($) profit/unit</p>
              </div>
              <p>variants</p>
              <p>base sku</p>
              <p>rating</p>
              <p>reviews</p>
              <p>front image</p>
              <p>rear image</p>
              <p>sizing image</p>
              <p></p>
            </div>
            <div class="product-data overflow-wide">
              <p class="uppercase"><%= product.brand %></p>
              <p><%= product.item_type %></p>
              <div class="currency-backdrop">
                <p><%= product.price_unit %></p>
                <p>-<%= product.cost_unit %></p>
                <p class="profit-line2">
                  <span class="highlight-color2"><%= product.profit_per_unit %></span>
                </p>
              </div>
              <% 
              // Define the custom order of sizes
              const customSizeOrder = ['S', 'M', 'L', 'XL'];

              // Get the size codes from the inventory
              const sizeCodes = Object.keys(product.inventoryBySize);

              // Sort the size codes according to the custom order
              sizeCodes.sort((a, b) => customSizeOrder.indexOf(a) - customSizeOrder.indexOf(b));
              %>
              <p><%= sizeCodes.join(", ") %></p>
              <p><%= product.base_sku %></p>
              <p><%= product.rating %></p>
              <p><%= product.review_count %></p>
              <p><%= product.imagesByType.front %></p>
              <p><%= product.imagesByType.rear %></p>
              <p><%= product.imagesByType.size %></p>
              <p></p>
            </div></div>
          </div>
          <div class="button-container">
            <button class="card-button1 toggle-additional-data">toggle</button>
              <form action="/products/<%= product.id %>/update" method="GET">
              <button class="card-button1">update</button>
            </form>
            <form class="delete-form-action" method="POST" action="/products/<%= product.id %>/delete" >
              <button class="card-button1">delete</button>
            </form>
          </div>
          <div class="inventory-notifications">
            <h2 class="uppercase">inventory notifications</h2> 
            <% if (product.inventoryBySize && Object.keys(product.inventoryBySize).length > 0) { %>
            <% const customSizeOrder = ['S', 'M', 'L', 'XL']; %>
            <% const sizeCodes = Object.keys(product.inventoryBySize).sort((a, b) => customSizeOrder.indexOf(a) - customSizeOrder.indexOf(b)); %>
            <% sizeCodes.forEach(function(sizeCode) { %>
              <% const size = product.inventoryBySize[sizeCode]; %>
                <div class="inventory-notice">
                  <p class="capitalize">&nbsp;•&nbsp;size (<%= sizeCode %>) @ 
                    <% size.forEach(function(variantSize) { %>
                      <span class="size-unit-count"><%= variantSize.units %> units <span class="unit-message"></span></span>
                    <% }); %>
                </div>
            <% }); %>
            <% } else { %>
              <p class="capitalize">no current messages</p>
            <% } %>
          </div>         
          <div class="additional-data hidden">
            <div class="product-tags">
              <h2 class="uppercase">search tags</h2>
              <% if (product.tags.length > 0) { %>
              <p><%= product.tags.join(", ") %> %></p>
              <% } else { %>
              <p class="capitalize">no current tags</p>
            <% } %>
            </div>
            <div class="button-container">
              <a class="card-button2" href="/products/under-construction">Add/View Notes</a>
              <a class="card-button2" href="/products/under-construction">Rating History</a>
              <a class="card-button2" href="/products/under-construction">Pricing History</a>
            </div>
            <div class="button-container">
              <a class="card-button2" href="/products/under-construction">Sales History</a>
              <a class="card-button2" href="/products/under-construction">Storage History</a>
              <a class="card-button2" href="/products/under-construction">Order History</a>
            </div>
          <% if (product.inventoryBySize && Object.keys(product.inventoryBySize).length > 0) { %>
            <% const customSizeOrder = ['S', 'M', 'L', 'XL']; %>
            <% const sizeCodes = Object.keys(product.inventoryBySize).sort((a, b) => customSizeOrder.indexOf(a) - customSizeOrder.indexOf(b)); %>
            <% sizeCodes.forEach(function(sizeCode) { %>
              <% const size = product.inventoryBySize[sizeCode]; %>
                <div class="row-container inventory-detail">
                  <div class="product-category">
                    <p>variant</p>
                    <p>sku</p>
                    <p>barcode</p>
                    <p>storage</p>      
                    <p>units</p>
                    <br>
                  </div>
                  <div class="product-data inventory-reorder">
                    <p class="uppercase"> size (<%= sizeCode %>)</p>
                    <% size.forEach(function(variantSize) { %>
                      <p><%= variantSize.sku %></p>
                      <p><%= variantSize.barcode %></p>
                      <p><%= variantSize.storage %></p>      
                      <p class="size-unit-count">
                        <%= variantSize.units %>
                        <span class="unit-message"></span>
                      </p>
                      <button class="reorder-button"></button>
                    <% }); %>
                  </div>
                </div>
            <% }); %>
          <% } else { %>
            <p class="uppercase">no inventory for size <%#= sizeCode %>.</p>
          <% } %>
        </div>
      </div>
    </div>
  <% }) %>
<% } else { %>
  <p class="uppercase">no products found</p>
<% } %>
  <script src="/js/main.js"></script>