                    <% }); %>
                  </div>
                </div>
            <% }); %>
          <% } else { %>
            <p>No messages.</p>
          <% } %>



          <div class="update-item-grid overflow-wide">
            <label for="animal_type">animal</label>
            <input
              class="lowercase"
              type="text"
              id="animal_type"
              name="animal_type"
              value="<%= product.animal_type %>"
              required
            />
            <label for="brand">brand</label>
            <input
              class="lowercase"
              type="text"
              id="brand"
              name="brand"
              value="<%= product.brand %>"
              required
            />
            <label for="item_type">item type</label>
            <input
              class="lowercase"
              type="text"
              id="item_type"
              name="item_type"
              value="<%= product.item_type %>"
            />
