  <!-- Search -->
  <form class="search-container hidden" method="GET" action="/products/list">
    <label class="uppercase white" for="search" hidden>Search</label>
    <input
      id="search"
      name="q"
      class="search-bar"
      type="text"
      placeholder="Search by onesie name..."
      value="<%= typeof search !== 'undefined' && search ? search : '' %>"
    />
    <button class="submit-button" type="submit">Search</button>
  </form>

  <!-- Various Filters -->
  <form class="filter-container hidden" method="GET" action="/products/list">
    <!-- Brand filter -->
    <div class="filter-item-div checkbox-item-container brand-range">
      <!-- <p>Brands</p> -->
      <% if (filterOptions?.brands) { %> <% filterOptions.brands.forEach(brand =>
      { %>
      <div class="checkbox-item">
        <label> Brand: <%= brand %> </label>
        <input type="checkbox" name="brand" value="<%= brand %>" <%=
        Array.isArray(activeFilters?.brand) ? activeFilters.brand.includes(brand)
        ? "checked" : "" : activeFilters?.brand === brand ? "checked" : "" %> >
      </div>
      <% }) %> <% } %>
    </div>
    <div class="min-max-item-container">
      <!-- Price filter -->
      <div class="filter-item-div min-max-item price-range">
        <p>Price</p>
        <input
          type="number"
          name="price_min"
          placeholder="Min"
          value="<%= activeFilters?.price_min || '' %>"
        />
        <input
          type="number"
          name="price_max"
          placeholder="Max"
          value="<%= activeFilters?.price_max || '' %>"
        />
      </div>
      <!-- Cost filter -->
      <div class="filter-item-div min-max-item cost-range">
        <p>Cost</p>
        <input
          type="number"
          name="cost_min"
          placeholder="Min"
          value="<%= activeFilters?.cost_min || '' %>"
        />
        <input
          type="number"
          name="cost_max"
          placeholder="Max"
          value="<%= activeFilters?.cost_max || '' %>"
        />
      </div>
      <!-- Profit filter -->
      <div class="filter-item-div min-max-item profit-range">
        <p>Profit</p>
        <input
          type="number"
          name="profit_min"
          placeholder="Min"
          value="<%= activeFilters?.profit_min || '' %>"
        />
        <input
          type="number"
          name="profit_max"
          placeholder="Max"
          value="<%= activeFilters?.profit_max || '' %>"
        />
      </div>
      <!-- Rating filter -->
      <div class="filter-item-div min-max-item rating-range">
        <p>Rating</p>
        <input
          type="number"
          name="rating_min"
          placeholder="Min"
          value="<%= activeFilters?.rating_min || '' %>"
        />
        <input
          type="number"
          name="rating_max"
          placeholder="Max"
          value="<%= activeFilters?.rating_max || '' %>"
        />
      </div>
      <!-- Review filter -->
      <div class="filter-item-div min-max-item review-range">
        <p>Reviews</p>
        <input
          type="number"
          name="review_min"
          placeholder="Min"
          value="<%= activeFilters?.review_min || '' %>"
        />
        <input
          type="number"
          name="review_max"
          placeholder="Max"
          value="<%= activeFilters?.review_max || '' %>"
        />
      </div>
    </div>
    <button class="submit-button apply-filters-button" type="submit">
      Apply Filters
    </button>
  </form>