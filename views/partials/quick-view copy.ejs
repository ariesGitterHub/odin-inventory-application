<% if (products && products.length) { %> <% products.forEach(product => { %>
<div class="quick-view">
  <div class="quick-view-details-col main-data">
    <h1>
      <span class="file-tab"
        >quick view:
        <span class="highlight-color"><%= product.animal_type %></span></span
      >
    </h1>
    <div class="quick-view-details-row">
      <!-- KEEP AS A REF FOR NOW -->
      <!-- <%# const frontImages = product.images.filter(img => img.type === 'front');
      %> <%# frontImages.forEach(img => { %>
      <img
        class="quick-view-image"
        src="/images/<%#= img.filename %>"
        alt="<%#= product.animal_type %> Front view"
      />
      <%# }) %> -->

      <% product.imagesByType.front && product.imagesByType.front.forEach(fn =>
      { %>
      <img
        class="quick-view-image"
        src="/images/<%= fn %>"
        alt="<%= product.animal_type %> front view"
      />
      <% }) %>

      <div class="quick-view-category">
        <p>item type</p>
        <p>brand</p>
        <div class="quick-view-money1">
          <p>($) price/unit</p>
          <p>($) cost/unit</p>
          <p class="quick-view-profit1">($) profit/unit</p>
        </div>
        <p>variants</p>
      </div>
      <div class="quick-view-data">
        <p><%= product.item_type %></p>
        <p><%= product.brand %></p>
        <div class="quick-view-money2">
          <p><%= product.price_unit %></p>
          <p>-<%= product.cost_unit %></p>
          <p class="quick-view-profit2">
            <span class="highlight-color2"><%= product.profit_per_unit %></span>
          </p>
        </div>
        <p>(S), (M), (L), (XL)</p>
      </div>
    </div>
    <div class="quick-view-notifications">
      <h2>notifications</h2>
      <!-- TODO - along with all the other items that need to be map and ejs'ed up, also make below messages programmatic-->
      <p>Notice: Reorder - (S) variant at 0 units.</p>
      <p>Notice: Reorder - (M) variant at 0 units.</p>
    </div>
    <div class="quick-view-button-container">
      <button class="card-button toggle-btn">view file</button>
      <button class="card-button">edit file</button>
    </div>
  </div>
  <div class="quick-view-details-col additional-data hidden">
    <h2>
      <span class="file-tab"
        >additional data:
        <span class="highlight-color"><%= product.animal_type %></span></span
      >
    </h2>

    <div class="quick-view-details-row">
      <% product.imagesByType.rear && product.imagesByType.rear.forEach(fn =>
      { %>
      <img
        class="quick-view-image"
        src="/images/<%= fn %>"
        alt="<%= product.animal_type %> rear view"
      />
      <% }) %>
      <div class="quick-view-category">
        <p>base sku</p>
        <p>rating</p>
        <p>reviews</p>
        <p>image front</p>
        <p>image back</p>
        <p>sizing image</p>
      </div>
      <div class="quick-view-data">
        <p><%= product.base_sku %></p>
        <p><%= product.rating %></p>
        <p><%= product.review_count %></p>
        <p>ffffffff.JPG</p>
        <p>product.imagesByType.rear</p>
        <p>sssssss.JPG</p>
      </div>
    </div>
    <div class="quick-view-button-container2">
      <button class="card-button long-button">Add/View Notes</button>
      <button class="card-button long-button">Rating History</button>
      <button class="card-button long-button">Pricing History</button>
    </div>
    <div class="quick-view-button-container2">
      <button class="card-button long-button">Sales History</button>
      <button class="card-button long-button">Storage History</button>
      <button class="card-button long-button">Order History</button>
    </div>
    <!-- <div class="quick-view-tags additional-data"> -->
    <div class="quick-view-tags">
      <h2>search tags</h2>
      <p>mammal, dinosaur, horsey, doggo</p>
    </div>
    <!-- <div class="quick-view-details-row variant-details additional-data"> -->
    <div class="quick-view-details-row variant-details">
      <div class="quick-view-category">
        <p>variant 1</p>
        <p>barcode</p>
        <p>sku</p>
        <p>units</p>
        <p>storage</p>
      </div>
      <div class="quick-view-data">
        <p>(s) small</p>
        <p>000000000000</p>
        <p>sizeSKU</p>
        <p>409 <span class="quick-view-unit-message">(overstock)</span></p>
        <p>atLocation</p>
      </div>
    </div>
    <!-- <div class="quick-view-details-row variant-details additional-data"> -->
    <div class="quick-view-details-row variant-details">
      <div class="quick-view-category">
        <p>variant 2</p>
        <p>barcode</p>
        <p>sku</p>
        <p>units</p>
        <p>storage</p>
      </div>
      <div class="quick-view-data">
        <p>(m) medium</p>
        <p>111111111111</p>
        <p>sizeSKU</p>
        <p>0 <span class="quick-view-unit-message">(restock)</span></p>
        <p>atLocation</p>
      </div>
    </div>
    <!-- <div class="quick-view-details-row variant-details additional-data"> -->
    <div class="quick-view-details-row variant-details">
      <div class="quick-view-category">
        <p>variant 3</p>
        <p>barcode</p>
        <p>sku</p>
        <p>units</p>
        <p>storage</p>
      </div>
      <div class="quick-view-data">
        <p>(l) large</p>
        <p>222222222222</p>
        <p>sizeSKU</p>
        <p>10 <span class="quick-view-unit-message">(low stock)</span></p>
        <p>atLocation</p>
      </div>
    </div>
    <!-- <div class="quick-view-details-row variant-details additional-data"> -->
    <div class="quick-view-details-row variant-details">
      <div class="quick-view-category">
        <p>variant 4</p>
        <p>barcode</p>
        <p>sku</p>
        <p>units</p>
        <p>storage</p>
      </div>
      <div class="quick-view-data">
        <p>(xl) extra large</p>
        <p>333333333333</p>
        <p>sizeSKU</p>
        <p>27 <span class="quick-view-unit-message">(okay)</span></p>
        <p>atLocation</p>
      </div>
    </div>
  </div>
</div>

<% }) %>
<script src="/js/main.js"></script>
<% } else { %>
<p>No products found.</p>
<% } %>
