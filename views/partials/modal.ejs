<div
  id="adminModal"
  class="modal hidden"
  role="dialog"
  aria-modal="true"
  aria-labelledby="adminModalTitle"
>
  <div class="modal-content">
    <button class="close-button" aria-label="Close modal">&times;</button>
    <h2 id="adminModalTitle">Admin Login</h2>
    <form id="adminLoginForm">
      <label for="adminPassword" hidden>Password</label>
      <input
        type="password"
        id="adminPassword"
        name="password"
        placeholder="Enter password..."
        autocomplete="current-password"
        required
      />
      <button class="submit-button" type="submit">Login</button>
    </form>
    <p id="adminError" class="admin-error-message uppercase"></p>
  </div>
</div>
