<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('./partials/head.ejs') %>
  </head>
  <body>
    <%- include('./partials/header.ejs') %>
    <main>
      <div class="create-item-view">
        <h1 class="create-item-title">Create New Item</h1>
        <form class="create-item" method="POST" action="/create">
          <%#- include('./partials/errors.ejs') %>
          <label for="animal_type">onesie animal type</label>
          <input
            type="text"
            id="animal_type"
            name="animal_type"
            placeholder="Enter animal type"
            required
          />

          <label for="brand">brand</label>
          <input
            type="text"
            id="brand"
            name="brand"
            placeholder="Enter brand name"
            required
          />

          <label for="item_type">item type</label>
          <input
            type="text"
            id="item_type"
            name="item_type"
            value="adult onesie"
          />

          <div class="price-cost-container">
            <!-- TODO - validate these as currency -->
            <div class="create-item-col">
              <label for="price_unit">price per unit</label>
              <input
                type="number"
                id="price_unit"
                name="price_unit"
                placeholder="Price to charge"
                required
              />
            </div>
            <div class="create-item-col">
              <label for="cost_unit">cost per unit</label>
              <input
                type="number"
                id="cost_unit"
                name="cost_unit"
                placeholder="Cost you paid"
                required
              />
            </div>
          </div>

          <!-- TODO - definitely enforce validation pattern on base sku -->
          <label for="base_sku">base sku</label>
          <input
            type="text"
            id="base_sku"
            name="base_sku"
            placeholder="enter 12 character base sku"
            required
          />

          <!-- TODO - rating and reviews start with a default of 0; 
             
            FUN FACT: an input's value will still be posted to the server if you use the hidden attribute-->
          <label for="rating" hidden>rating</label>
          <input type="number" id="rating" name="rating" value="0" hidden />
          <label for="review_count" hidden>reviews</label>
          <input
            type="number"
            id="review_count"
            name="review_count"
            value="0"
            hidden
          />

          <label for="unknown_front">front image link</label>
          <input
            type="url"
            id="unknown_front"
            name="unknown_front"
            placeholder="Enter the front view url"
            required
          />
          <label for="unknown_rear">rear image link</label>
          <input
            type="url"
            id="unknown_rear"
            name="unknown_rear"
            placeholder="Enter the rear view url"
            required
          />
          <label for="unknown_sizing">sizing image link</label>
          <input
            type="url"
            id="unknown_sizing"
            name="unknown_sizing"
            placeholder="Enter the sizing view url"
            required
          />

          <!-- TODO - figure out starting tags -->
          <!-- TODO - figure out starting inventory with size, barcode, units, storage-->
          <div class="create-view-button-container">
            <button>Submit Newly Created Item</button>   
          </div>      
        </form>
      </div>
    </main>
    <%- include('./partials/footer.ejs') %>
  </body>
</html>
