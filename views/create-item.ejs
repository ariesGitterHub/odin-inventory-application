<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('./partials/head.ejs') %>
  </head>
  <body>
    <%- include('./partials/header.ejs') %>
    <!-- <main> -->
      <%- include("partials/errors.ejs") %>
      <div class="card create-item-colors">
        <h1 class="page-title black capitalize">create new item</h1>
        <form class="create-item-form" method="POST" action="/create">
          <%#- include('./partials/errors.ejs') %>
          <label for="product_name">onesie name</label>
          <input
            type="text"
            id="product_name"
            name="product_name"
            placeholder="Enter animal type"
            required
          />

          <label for="brand">brand</label>
          <input
            type="text"
            id="brand"
            name="brand"
            placeholder="Enter brand name"
            required
          />

          <label for="item_type">item type</label>
          <input
            type="text"
            id="item_type"
            name="item_type"
            value="adult onesie"
          />

          <div class="price-cost-container">
            <!-- TODO - validate these as currency -->
              <!-- placeholder="They pay (00.00)" -->
              <!-- placeholder="You paid (00.00)" -->
            <div class="col-container">
              <label for="price_unit">price per unit</label>
              <input
                type="number"
                step="0.01"
                id="price_unit"
                name="price_unit"
                value=00.00
              />
            </div>
            <div class="col-container">
              <label for="cost_unit">cost per unit</label>
              <input
                type="number"
                step="0.01"
                id="cost_unit"
                name="cost_unit"
                value=00.00
              />
            </div>
          </div>

          <!-- TODO - definitely enforce validation pattern on base sku -->
          <label for="base_sku">base sku <span class="lowercase italic">(pattern: <span class="uppercase">XXXXX123YYY-</span>)</span></label>
          <input
            class="uppercase"
            type="text"
            id="base_sku"
            name="base_sku"
            placeholder="Enter 12 character base sku"
            required
          />

          <!-- TODO - rating and reviews start with a default of 0; 
             
            FUN FACT: an input's value will still be posted to the server if you use the hidden attribute-->
          <label for="rating" hidden>rating</label>
          <input type="number" id="rating" name="rating" value="0" hidden />
          <label for="review_count" hidden>reviews</label>
          <input
            type="number"
            id="review_count"
            name="review_count"
            value="0"
            hidden
          />

          <label for="front">front image <span class="lowercase italic">(filename or link)</span></label>
          <input
            type="text"
            id="front"
            name="front"
            placeholder="Enter the front view url"
            required
          />
          <label for="rear">rear image <span class="lowercase italic">(filename or link)</span></label>
          <input
            type="text"
            id="rear"
            name="rear"
            placeholder="Enter the rear view url"
            required
          />
          <label for="size">sizing image <span class="lowercase italic">(filename or link)</span></label>
          <input
            type="text" 
            id="size"
            name="size"
            value="n/a (add during a review update)"
            required
          />

          <!-- TODO - figure out starting tags -->
          <label for="tags">tags <span class="lowercase italic">(comma separated)</span></label>
          <input
            type="text"
            id="tags"
            name="tags"
            placeholder="E.g., mammal, fruit, vegetable"
          />
          <div class="tag-cloud">
            <% if (tags && tags.length > 0) { %> 
              <% tags.forEach(tag => { %>
                <button 
                type="button" 
                class="tag-cloud-item-button" 
                data-tag="<%= tag.name %>"
                >
                  <%= tag.name %>
                </button>
              <% }) %>
              <% } else { %>
                <p class="capitalize">no current tags found</p>
              <% } %>    
          </div>
          <script src="/helpers/addTag.js"></script>
          <!-- TODO - figure out starting inventory with size, barcode, units, storage-->
          <label hidden>initial inventory</label>

          <input type="text" name="sizes[]" value="S" hidden />
          <input type="text" name="barcodes[]" value="n/a" hidden />
          <input type="number" name="units[]" value=0 hidden />
          <input type="text" name="storage[]" value="n/a" hidden />

          <input type="text" name="sizes[]" value="M" hidden />
          <input type="text" name="barcodes[]" value="n/a" hidden />
          <input type="number" name="units[]" value=0 hidden />
          <input type="text" name="storage[]" value="n/a" hidden />

          <input type="text" name="sizes[]" value="L" hidden />
          <input type="text" name="barcodes[]" value="n/a" hidden />
          <input type="number" name="units[]" value=0 hidden />
          <input type="text" name="storage[]" value="n/a" hidden />

          <input type="text" name="sizes[]" value="XL" hidden />
          <input type="text" name="barcodes[]" value="n/a" hidden />
          <input type="number" name="units[]" value=0 hidden />
          <input type="text" name="storage[]" value="n/a" hidden />
          <div class="button-container3">
            <a class="cancel-button" href="/">Cancel</a> 
            <button class="submit-button" type="submit">Submit</button>   
          </div>      
        </form>
      </div>
    <!-- </main> -->
    <%#- include('./partials/footer.ejs') %>
  </body>
</html>
